# It skips certificate validation for various parts of oCIS and is needed if you use self signed certificates.
export OCIS_INSECURE=false

# oCIS version. Defaults to "latest"
export OCIS_DOCKER_TAG=

# oCIS openid issuer (i.e. Ory Auth Domain)
export OCIS_OIDC_ISSUER=dev-auth.project-holi.org

# oCIS domain, where you can find the frontend. For local development use: "https://localhost:9200"
export OCIS_DOMAIN=

# oCIS Web openid connect client id (i.e. Ory Client ID)
export OCIS_OIDC_CLIENT_ID=b1c892b2-3746-4fca-a3f7-b3bafcffd9ee

# oCIS logs
export OCIS_LOG_DRIVER=local
export OCIS_LOG_COLOR=false
export OCIS_LOG_LEVEL=info
